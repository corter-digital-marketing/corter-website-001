---
/**
 * Contact form. Submission is unchanged from the old site: it POSTs to the same
 * Formspree endpoint with the same field names (name, phone, email, message).
 */
import Button from './Button.astro';

interface Props { id?: string }
const { id = 'contact' } = Astro.props;
---
<form class="grid gap-8" id={`${id}-form`} action="https://formspree.io/f/mwvzvkaw" method="POST" novalidate data-ajax>
  <p class="form-status form-status--success" role="status" tabindex="-1">Message sent. We'll be in touch, usually the same day.</p>
  <p class="form-status form-status--error" role="alert" tabindex="-1">That didn't go through. Try again, or call <a href="tel:+15705024036">(570) 502-4036</a>.</p>

  <div class="grid gap-8 sm:grid-cols-2">
    <div class="field">
      <label class="text-small font-medium" for={`${id}-name`}>Name</label>
      <input class="input" id={`${id}-name`} type="text" name="name" autocomplete="name" required aria-describedby={`${id}-name-err`} />
      <p class="field-error" id={`${id}-name-err`}></p>
    </div>
    <div class="field">
      <label class="text-small font-medium" for={`${id}-phone`}>Phone (optional)</label>
      <input class="input num" id={`${id}-phone`} type="tel" name="phone" autocomplete="tel" />
    </div>
  </div>
  <div class="field">
    <label class="text-small font-medium" for={`${id}-email`}>Email</label>
    <input class="input" id={`${id}-email`} type="email" name="email" autocomplete="email" required aria-describedby={`${id}-email-err`} />
    <p class="field-error" id={`${id}-email-err`}></p>
  </div>
  <div class="field">
    <label class="text-small font-medium" for={`${id}-message`}>What do you need? (optional)</label>
    <textarea class="input" id={`${id}-message`} name="message" rows="4"></textarea>
  </div>
  <Button type="submit" block>Send message</Button>
</form>
