---
/**
 * "What do you need help with?" Plain-language choices that take visitors
 * straight to the right page. Each whole block is one big link.
 */
const choices = [
  {
    need: 'I need a website',
    text: 'A professional website that gets you calls. Pick a ready-made design or a fully custom one.',
    price: 'From $200',
    href: '/websites',
    cta: 'See website options',
  },
  {
    need: 'I need help with social media',
    text: 'We run your pages for you, or we make the photos and videos for you to post.',
    price: 'From $500 a month',
    href: '/social-media',
    cta: 'See social media options',
  },
  {
    need: 'I want to show up on Google',
    text: 'Get found on Google and Bing, and in answers from AI tools like ChatGPT.',
    price: 'Two options',
    href: '/seo',
    cta: 'See SEO options',
  },
  {
    need: 'I want to learn to do it myself',
    text: 'Our course teaches the same social media system behind 10M+ views.',
    price: 'Waitlist open',
    href: '/courses',
    cta: 'See the course',
  },
];
---
<ul class="grid-12 border-t border-line">
  {choices.map((c, i) => (
    <li class:list={['col-span-4 border-b border-line lg:col-span-6', i % 2 === 0 && 'lg:border-r']}>
      <a href={c.href} class="group cell flex h-full flex-col gap-4 py-8 transition-colors duration-500 hover:bg-ink/[.03] lg:py-12">
        <h3 class="text-heading"><span class="u-link">{c.need}</span></h3>
        <p class="muted max-w-[46ch]">{c.text}</p>
        <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-4">
          <span class="text-small font-medium">{c.price}</span>
          <span class="btn btn-secondary">{c.cta} <span class="arrow" aria-hidden="true">→</span></span>
        </div>
      </a>
    </li>
  ))}
</ul>
<p class="frame grid-12">
  <span class="cell col-span-4 py-6 text-body lg:col-span-12">
    Not sure what you need? Call <a href="tel:+15705024036" class="num font-medium underline underline-offset-4">(570) 502-4036</a> and we'll point you the right way.
  </span>
</p>
