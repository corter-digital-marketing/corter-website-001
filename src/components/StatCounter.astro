---
/**
 * Animated stat. The final value is rendered in HTML so it's correct without JS;
 * motion.ts counts up from 0 when it scrolls into view.
 */
interface Props {
  value: number;
  prefix?: string;
  suffix?: string;
  label: string;
  index?: string;
  class?: string;
}
const { value, prefix = '', suffix = '', label, index, class: cls = '' } = Astro.props;
---
<div class:list={['flex flex-col justify-between gap-10 p-6 md:p-10', cls]}>
  {index && <span class="label label-accent">{index}</span>}
  <div>
    <p
      class="display-lg tabular-nums text-ink"
      data-count={value}
      data-prefix={prefix}
      data-suffix={suffix}
    >{prefix}{value}{suffix}</p>
    <p class="label mt-4">{label}</p>
  </div>
</div>
