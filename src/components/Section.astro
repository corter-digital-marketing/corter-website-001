---
/**
 * Page section: a big, bold title with an optional one-line intro, then the
 * section content. Sections are separated by a full-bleed hairline.
 * (`n` and `marks` are accepted for compatibility; neither is shown.)
 */
interface Props {
  n?: string;
  name: string;
  /** Optional one-line intro under the title */
  meta?: string;
  id?: string;
  marks?: boolean;
  class?: string;
}
const { name, meta, id, class: cls = '' } = Astro.props;
const headingId = `${id ?? name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-title`;
---
<section class:list={['band', cls]} id={id} aria-labelledby={headingId}>
  <div class="frame grid-12 pb-10 pt-16 lg:pb-14 lg:pt-24">
    <h2 id={headingId} class="cell col-span-4 text-heading font-semibold lg:col-span-12">{name}</h2>
    {meta && <p class="muted cell col-span-4 mt-4 text-body lg:col-span-7">{meta}</p>}
  </div>
  <slot />
</section>
