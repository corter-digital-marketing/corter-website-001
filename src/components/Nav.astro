---
/**
 * Main navigation. Kept deliberately simple: every service is a top-level
 * link (no hidden dropdowns), and the phone number is always visible.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-mark.png';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const is = (href: string) => path === href || path.startsWith(href + '/');

const services = [
  { href: '/websites', label: 'Websites', desc: 'A new website, built and looked after' },
  { href: '/social-media', label: 'Social Media', desc: 'We run your pages or make your content' },
  { href: '/seo', label: 'SEO', desc: 'Show up on Google and in AI answers' },
];
const more = [
  { href: '/courses', label: 'Courses', desc: 'Learn to do it yourself' },
  { href: '/portfolio', label: 'Our Work', desc: 'Businesses we’ve helped' },
  { href: '/learn', label: 'Learn', desc: 'Courses and free guides' },
  { href: '/about', label: 'About', desc: 'Who we are' },
  { href: '/contact', label: 'Contact', desc: 'Call, email or send a message' },
];
const desktop = [...services, ...more.filter((l) => l.href !== '/contact')];
---
<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500" data-header>
  <nav class="frame flex h-[72px] items-center justify-between gap-1 sm:gap-4" aria-label="Main">
    <a href="/" class="cell flex min-w-0 shrink items-center gap-2 !pr-0 sm:gap-2.5" aria-label="Corter Digital home">
      <Image src={logo} alt="" width={32} densities={[1, 2]} class="h-auto w-7 sm:w-8" loading="eager" />
      <span class="truncate text-small font-medium">Corter Digital</span>
    </a>

    <ul class="hidden items-center xl:flex">
      {desktop.map((l) => (
        <li><a href={l.href} class:list={['nav-link', is(l.href) && 'is-active']} aria-current={is(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-2 pr-[var(--pad)] sm:gap-3">
      <a href="tel:+15705024036" class="num u-link hidden text-small font-medium md:inline">(570) 502-4036</a>
      <a href="/contact" class="btn btn-primary hidden sm:inline-flex">Free quote <span class="arrow" aria-hidden="true">→</span></a>
      <a href="tel:+15705024036" class="btn btn-secondary !min-h-11 !px-3.5 sm:hidden" aria-label="Call (570) 502-4036">Call</a>
      <button
        type="button"
        class="btn btn-secondary !min-h-11 !px-3.5 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-word-open">Menu</span><span class="menu-word-close hidden">Close</span>
      </button>
    </div>
  </nav>

  <!-- Full-screen menu (phones, tablets, small laptops) -->
  <div id="mobile-menu" class="mobile-menu fixed inset-x-0 bottom-0 top-[72px] z-40 overflow-y-auto border-t border-line bg-base xl:hidden" data-mobile-menu inert>
    <nav class="frame grid-12 pb-10" aria-label="Menu">
      <div class="col-span-4 lg:col-span-6">
        <p class="cell muted pb-3 pt-8 text-small font-medium">Our services</p>
        <ul class="border-t border-line">
          {services.map((l) => (
            <li class="border-b border-line">
              <a href={l.href} class="cell group flex items-center justify-between gap-4 py-5" aria-current={is(l.href) ? 'page' : undefined}>
                <span>
                  <span class:list={['block text-heading', is(l.href) && 'text-brand-blue']}>{l.label}</span>
                  <span class="muted mt-1 block text-small">{l.desc}</span>
                </span>
                <span class="arrow text-heading" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="col-span-4 lg:col-span-6">
        <p class="cell muted pb-3 pt-8 text-small font-medium">More</p>
        <ul class="border-t border-line">
          {more.map((l) => (
            <li class="border-b border-line">
              <a href={l.href} class="cell group flex items-center justify-between gap-4 py-4" aria-current={is(l.href) ? 'page' : undefined}>
                <span>
                  <span class:list={['block text-body font-medium', is(l.href) && 'text-brand-blue']}>{l.label}</span>
                  <span class="muted block text-small">{l.desc}</span>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="cell col-span-4 mt-8 grid gap-3 sm:grid-cols-2 lg:col-span-12">
        <a href="tel:+15705024036" class="btn btn-secondary btn-block">Call (570) 502-4036 <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/contact" class="btn btn-primary btn-block">Get a free quote <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 72px;
    padding-inline: .8rem;
    font-size: var(--text-small);
    font-weight: 500;
    color: rgb(243 239 232 / .8);
    transition: color .4s var(--ease-precise);
  }
  .nav-link:hover, .nav-link.is-active { color: var(--color-ink); }
  /* Active page: a brand-blue rule on the header's bottom edge */
  .nav-link.is-active::after {
    content: "";
    position: absolute; left: .8rem; right: .8rem; bottom: -1px; height: 2px;
    background: var(--color-brand-blue);
  }

  .site-header.is-scrolled, .site-header.menu-open {
    background: var(--color-base);
    border-bottom-color: var(--color-line);
  }

  .mobile-menu { opacity: 0; visibility: hidden; transition: opacity .4s var(--ease-precise), visibility .4s; }
  .site-header.menu-open .mobile-menu { opacity: 1; visibility: visible; }
  .site-header.menu-open .menu-word-open { display: none; }
  .site-header.menu-open .menu-word-close { display: inline; }
</style>
