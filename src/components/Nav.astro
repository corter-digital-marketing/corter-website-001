---
/**
 * Main navigation. Kept deliberately simple: every service is a top-level
 * link (no hidden dropdowns), and the phone number is always visible.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-mark.png';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const is = (href: string) => path === href || path.startsWith(href + '/');

const services = [
  { href: '/websites', label: 'Websites' },
  { href: '/social-media', label: 'Social Media' },
  { href: '/seo', label: 'SEO' },
];
const more = [
  { href: '/portfolio', label: 'Our Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const desktop = [...services, ...more.filter((l) => l.href !== '/contact')];
const mobile = [...services, ...more];
---
<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500" data-header>
  <nav class="frame flex h-[72px] items-center justify-between gap-1 sm:gap-4" aria-label="Main">
    <a href="/" class="cell flex min-w-0 shrink items-center gap-2 !pr-0 sm:gap-2.5" aria-label="Corter Digital home">
      <Image src={logo} alt="" width={32} densities={[1, 2]} class="h-auto w-7 sm:w-8" loading="eager" />
      <span class="truncate text-small font-medium">Corter Digital</span>
    </a>

    <ul class="hidden items-center xl:flex">
      {desktop.map((l) => (
        <li><a href={l.href} class:list={['nav-link', is(l.href) && 'is-active']} aria-current={is(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-2 pr-[var(--pad)] sm:gap-3">
      <a href="tel:+15705024036" class="num u-link hidden text-small font-medium md:inline">(570) 502-4036</a>
      <a href="/contact" class="btn btn-primary hidden sm:inline-flex">Free quote <span class="arrow" aria-hidden="true">→</span></a>
      <a href="tel:+15705024036" class="icon-btn grid place-items-center sm:hidden" aria-label="Call (570) 502-4036">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
      </a>
      <button
        type="button"
        class="icon-btn grid place-items-center xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </nav>

  <!-- Full-screen menu (phones, tablets, small laptops) -->
  <div id="mobile-menu" class="mobile-menu fixed inset-x-0 bottom-0 top-[72px] z-40 overflow-y-auto border-t border-line bg-base xl:hidden" data-mobile-menu inert>
    <nav class="frame flex min-h-full flex-col pb-10" aria-label="Menu">
      <ul class="pt-4">
        {mobile.map((l) => (
          <li>
            <a href={l.href} class:list={['cell block py-3.5 text-heading', is(l.href) ? 'text-brand-blue' : 'text-ink']} aria-current={is(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <div class="cell mt-auto grid gap-4 pt-10">
        <a href="/contact" class="btn btn-primary btn-block">Get a free quote <span class="arrow" aria-hidden="true">→</span></a>
        <a href="tel:+15705024036" class="num muted text-center text-small">Or call (570) 502-4036</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 72px;
    padding-inline: .8rem;
    font-size: var(--text-small);
    font-weight: 500;
    color: rgb(243 239 232 / .8);
    transition: color .4s var(--ease-precise);
  }
  .nav-link:hover, .nav-link.is-active { color: var(--color-ink); }
  /* Active page: a brand-blue rule on the header's bottom edge */
  .nav-link.is-active::after {
    content: "";
    position: absolute; left: .8rem; right: .8rem; bottom: -1px; height: 2px;
    background: var(--color-brand-blue);
  }

  .site-header.is-scrolled, .site-header.menu-open {
    background: var(--color-base);
    border-bottom-color: var(--color-line);
  }

  .mobile-menu { opacity: 0; visibility: hidden; transition: opacity .4s var(--ease-precise), visibility .4s; }
  .site-header.menu-open .mobile-menu { opacity: 1; visibility: visible; }

  /* Icon buttons (phone, menu) */
  .icon-btn {
    width: 44px; height: 44px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    transition: border-color .4s var(--ease-precise);
  }
  .icon-btn:hover { border-color: var(--color-ink); }
  .burger { position: relative; display: block; width: 18px; height: 12px; }
  .burger i {
    position: absolute; left: 0; width: 100%; height: 1.5px; border-radius: 1px;
    background: currentColor;
    transition: transform .4s var(--ease-precise), opacity .2s;
  }
  .burger i:nth-child(1) { top: 0; }
  .burger i:nth-child(2) { top: 5.25px; }
  .burger i:nth-child(3) { top: 10.5px; }
  .site-header.menu-open .burger i:nth-child(1) { transform: translateY(5.25px) rotate(45deg); }
  .site-header.menu-open .burger i:nth-child(2) { opacity: 0; }
  .site-header.menu-open .burger i:nth-child(3) { transform: translateY(-5.25px) rotate(-45deg); }
</style>
