---
/**
 * Options with prices, one row each: name | price | what you get | button.
 * Kept deliberately plain: no column headers, no bullets. The section title
 * above it (via <Section>) says what the options are.
 */
interface Plan {
  name: string;
  note?: string;
  price: string;
  unit?: string;
  features: string[];
  cta?: string;
  /** Price not set yet: renders a visible 'to supply' slot */
  pricePending?: boolean;
}
interface Props {
  plans: Plan[];
  /** Accepted for compatibility; not shown */
  title?: string;
  caption?: string;
}
const { plans } = Astro.props;
---
<div class="border-t border-line">
  {plans.map((p) => (
    <div class="grid-12 items-start gap-y-5 border-b border-line py-8 lg:py-10">
      <div class="cell col-span-4 lg:col-span-4">
        <h3 class="text-body font-semibold">{p.name}</h3>
        {p.note && <p class="muted mt-1 text-small">{p.note}</p>}
      </div>
      <p class="cell col-span-4 lg:col-span-2">
        {p.pricePending ? (
          <span class="slot label inline-block px-2 py-1">[Price]</span>
        ) : (
          <>
            <span class="num text-body font-semibold">{p.price}</span>
            {p.unit && <span class="muted ml-1 text-small">{p.unit}</span>}
          </>
        )}
      </p>
      <ul class="cell col-span-4 grid gap-2 lg:col-span-4">
        {p.features.map((f) => <li>{f}</li>)}
      </ul>
      <p class="cell col-span-4 lg:col-span-2 lg:text-right">
        <a href="/contact" class="btn btn-primary w-full lg:w-auto">{p.cta ?? 'Get started'} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> with {p.name}</span></a>
      </p>
    </div>
  ))}
</div>
