---
/** Pricing as a spec table: plan | price | what's included | action. */
interface Plan {
  name: string;
  note: string;
  price: string;
  unit?: string;
  features: string[];
  cta?: string;
  /** Highlight one plan per page at most (brand color) */
  highlight?: boolean;
  /** Price not set yet: renders a visible 'to supply' slot */
  pricePending?: boolean;
}
interface Props {
  title: string;
  caption?: string;
  plans: Plan[];
}
const { title, caption, plans } = Astro.props;
---
<div>
  <div class="grid-12 border-b border-line py-4">
    <h3 class="cell col-span-4 text-body font-medium lg:col-span-5">{title}</h3>
    {caption && <p class="muted cell col-span-4 text-small lg:col-span-7">{caption}</p>}
  </div>
  <div class="hidden grid-12 border-b border-line py-3 lg:grid" aria-hidden="true">
    <span class="muted cell col-span-3 text-small">Option</span>
    <span class="muted cell col-span-2 text-small">Price</span>
    <span class="muted cell col-span-5 text-small">What you get</span>
  </div>
  {plans.map((p) => (
    <div class="grid-12 items-baseline gap-y-5 border-b border-line py-7 lg:py-9">
      <div class="cell col-span-2 lg:col-span-3">
        <p class="text-heading">{p.name}</p>
        <p class="muted mt-1 text-small">{p.note}</p>
      </div>
      <p class="cell col-span-2 text-right lg:col-span-2 lg:text-left">
        {p.pricePending ? (
          <span class="slot label inline-block px-2 py-1">[Price]</span>
        ) : (
          <>
            <span class:list={['num text-heading', p.highlight && 'text-brand-blue']}>{p.price}</span>
            {p.unit && <span class="muted ml-1 text-small">{p.unit}</span>}
          </>
        )}
      </p>
      <ul class="cell col-span-4 grid gap-1.5 text-small lg:col-span-5">
        {p.features.map((f) => <li class="flex gap-3"><span class="muted" aria-hidden="true">—</span><span>{f}</span></li>)}
      </ul>
      <p class="cell col-span-4 lg:col-span-2 lg:text-right">
        <a href="/contact" class="btn btn-secondary w-full lg:w-auto">{p.cta ?? 'Get started'} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> with {p.name}</span></a>
      </p>
    </div>
  ))}
</div>
