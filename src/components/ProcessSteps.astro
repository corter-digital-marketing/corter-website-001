---
/**
 * Three-step process. On desktop (with motion) the section pins and the steps
 * light up in sequence as you scroll. Everywhere else it's a plain list.
 */
import SectionLabel from './SectionLabel.astro';

interface Step { title: string; text: string }
interface Props {
  index?: string;
  line1: string;
  line2: string;
  steps: Step[];
}
const { index = '04', line1, line2, steps } = Astro.props;
---
<section class="relative flex min-h-[100svh] flex-col justify-center overflow-hidden border-t border-ink/10 bg-surface" data-pin-steps aria-labelledby="process-title">
  <div class="grid-guides" aria-hidden="true"></div>
  <div class="container-x section relative">
    <div class="mb-16 grid gap-8 lg:mb-24 lg:grid-cols-2 lg:items-end">
      <div>
        <SectionLabel index={index} class="mb-8">Process</SectionLabel>
        <h2 id="process-title" class="display-lg" data-split>{line1}<br /><span class="dim">{line2}</span></h2>
      </div>
      <p class="lead max-w-[40ch] lg:justify-self-end">You run your business. We handle the rest, one clear step at a time.</p>
    </div>

    <!-- progress rail -->
    <div class="relative hidden h-px bg-ink/15 lg:block" aria-hidden="true">
      <span class="absolute inset-0 origin-left scale-x-0 bg-brand-blue" data-step-progress></span>
    </div>

    <ol class="grid border-ink/10 lg:grid-cols-3 lg:border-l">
      {steps.map((s, i) => (
        <li class="step relative border-t border-ink/10 py-10 lg:border-r lg:border-t-0 lg:px-10 lg:pb-4 lg:pt-12" data-step>
          <span class="step-dot absolute -top-[5px] left-0 hidden h-[9px] w-[9px] border border-brand-blue bg-base lg:left-10 lg:block" aria-hidden="true"></span>
          <p class="label label-accent mb-6">Step {String(i + 1).padStart(2, '0')}</p>
          <h3 class="display-md mb-5">{s.title}</h3>
          <p class="max-w-[34ch] text-ink/70">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    :global(html.motion) .step { transition: opacity .6s var(--ease-out-expo); }
    :global(html.motion) .step:not(.is-active) { opacity: .28; }
    .step.is-active .step-dot { background: var(--color-brand-blue); box-shadow: 0 0 0 4px rgb(47 125 246 / .25); }
  }
</style>
