---
/**
 * Section heading row: a plain section name, with an optional short note on
 * the right (e.g. "Waitlist open"). `n` is accepted for ordering in code but
 * not shown: plain words are easier to follow than numbering.
 */
interface Props {
  n?: string;
  meta?: string;
  class?: string;
}
const { meta, class: cls = '' } = Astro.props;
---
<div class:list={['flex items-baseline justify-between gap-4', cls]}>
  <p class="text-small font-medium"><slot /></p>
  {meta && <p class="muted hidden text-small sm:block">{meta}</p>}
</div>
