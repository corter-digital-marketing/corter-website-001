---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  block?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', external = false, block = false, type = 'button', class: cls = '', ...rest } = Astro.props;
const classes = ['btn', `btn-${variant}`, block && 'btn-block', cls].filter(Boolean).join(' ');
const arrow = external ? '↗' : '→';
---
{href ? (
  <a href={href} class={classes} {...(external ? { target: '_blank', rel: 'noopener' } : {})} {...rest}>
    <span class="btn-label"><slot /></span>
    {external && <span class="sr-only"> (opens in a new tab)</span>}
    <span class="arrow" aria-hidden="true">{arrow}</span>
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <span class="btn-label"><slot /></span>
    <span class="arrow" aria-hidden="true">→</span>
  </button>
)}
