---
/**
 * A number in a data row. Final value is in the HTML (correct without JS);
 * motion.ts counts up from 0 when it scrolls into view.
 */
interface Props {
  value: number;
  prefix?: string;
  suffix?: string;
  label: string;
  note?: string;
  accent?: boolean;
  /** false for values that shouldn't count up, like prices */
  count?: boolean;
  class?: string;
}
const { value, prefix = '', suffix = '', label, note, accent = false, count = true, class: cls = '' } = Astro.props;
---
<div class:list={['cell flex flex-col justify-between gap-10 py-8 lg:py-10', cls]}>
  <p class="label">{label}</p>
  <div>
    <p class:list={['num text-display font-medium', accent && 'text-brand-blue']} data-count={count ? value : undefined} data-prefix={prefix} data-suffix={suffix}>{prefix}{value}{suffix}</p>
    {note && <p class="label mt-3">{note}</p>}
  </div>
</div>
