---
/**
 * Inner-page hero: a spec-header row of metadata, a large left-aligned
 * headline across 9–10 columns, and a lead offset to the right columns.
 */
import HeroMedia from './HeroMedia.astro';

interface Props {
  /** Metadata cells across the top, e.g. ["01 — Websites", "From $200", "Care from $99/mo"] */
  meta: string[];
  title: string;
  lead?: string;
  media?: string;
}
const { meta, title, lead, media } = Astro.props;
---
<section class="relative overflow-hidden pt-16">
  {media && <HeroMedia name={media} />}
  <div class="frame grid-12 relative border-b border-line">
    {meta.map((m, i) => (
      <p class:list={['label num cell col-span-2 py-4 lg:col-span-3', i > 1 && 'hidden lg:block']}>{m}</p>
    ))}
  </div>
  <div class="frame grid-12 relative pb-14 pt-20 lg:pb-20 lg:pt-32">
    <h1 class="cell col-span-4 text-display font-medium lg:col-span-10" data-split>{title}</h1>
    {lead && <p class="muted cell col-span-4 mt-10 lg:col-span-4 lg:col-start-8 lg:mt-16">{lead}</p>}
    {Astro.slots.has('default') && (
      <div class="cell col-span-4 mt-8 flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:col-start-8"><slot /></div>
    )}
  </div>
</section>
