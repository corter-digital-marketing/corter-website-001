---
/** Footer. Same structure and information as the live site footer, in the new style. */
const site = [
  { href: '/', label: 'Home' },
  { href: '/#services', label: 'Services' },
  { href: '/portfolio', label: 'Our Work' },
  { href: '/learn', label: 'Learn' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const services = [
  { href: '/websites', label: 'Websites' },
  { href: '/social-media', label: 'Social Media' },
  { href: '/seo', label: 'SEO' },
  { href: '/courses', label: 'Courses' },
];
const year = new Date().getFullYear();
---
<footer class="band relative z-[1] marks">
  <div class="frame grid-12 gap-y-12 py-16 lg:py-24">
    <div class="cell col-span-4 lg:col-span-3">
      <a href="/" class="text-body font-medium">Corter Digital</a>
      <p class="muted mt-4 max-w-[34ch] text-small">Websites, social media marketing, and content creation for businesses that want real customers.</p>
    </div>

    <div class="cell col-span-2">
      <h2 class="muted mb-4 text-small font-medium">Site</h2>
      <ul class="grid gap-2.5 text-small">
        {site.map((l) => <li><a href={l.href} class="u-link">{l.label}</a></li>)}
      </ul>
    </div>

    <div class="cell col-span-2">
      <h2 class="muted mb-4 text-small font-medium">Services</h2>
      <ul class="grid gap-2.5 text-small">
        {services.map((l) => <li><a href={l.href} class="u-link">{l.label}</a></li>)}
      </ul>
    </div>

    <div class="cell col-span-4 lg:col-span-3">
      <h2 class="muted mb-4 text-small font-medium">Contact</h2>
      <ul class="grid gap-2.5 text-small">
        <li><a href="tel:+15705024036" class="num u-link">(570) 502-4036</a></li>
        <li><a href="mailto:andrewcsmma@gmail.com" class="u-link">andrewcsmma@gmail.com</a></li>
      </ul>
    </div>

    <div class="cell col-span-2">
      <h2 class="muted mb-4 text-small font-medium">Follow</h2>
      <ul class="grid gap-2.5 text-small">
        <li><a href="https://www.instagram.com/corterdigital" target="_blank" rel="noopener" class="u-link">Instagram<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61583891445369" target="_blank" rel="noopener" class="u-link">Facebook<span class="sr-only"> (opens in a new tab)</span></a></li>
      </ul>
    </div>
  </div>

  <div class="band">
    <div class="frame grid-12 py-5">
      <p class="muted cell col-span-4 text-small">© <span data-year>{year}</span> Corter Digital. All rights reserved.</p>
    </div>
  </div>
</footer>
