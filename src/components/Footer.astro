---
import { Image } from 'astro:assets';
import logo from '../assets/logo-mark.png';
import Icon from './Icon.astro';

const cols = [
  {
    title: 'Done for you',
    links: [
      { href: '/websites', label: 'Websites' },
      { href: '/social-media', label: 'Social Media' },
      { href: '/portfolio', label: 'Our Work' },
    ],
  },
  {
    title: 'Learn it yourself',
    links: [
      { href: '/courses', label: 'Courses' },
      { href: '/learn', label: 'Learn' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];
---
<footer class="relative overflow-hidden border-t border-ink/10 bg-base">
  <div class="container-x">
    <div class="grid gap-12 py-16 md:py-24 lg:grid-cols-[1.4fr_repeat(3,1fr)_1.3fr] lg:gap-8">
      <div>
        <a href="/" class="inline-flex items-center gap-3" aria-label="Corter Digital home">
          <Image src={logo} alt="" width={38} densities={[1, 2]} class="h-auto w-[38px]" />
          <span class="font-display text-[1.0625rem] font-bold uppercase tracking-[0.02em] [font-stretch:90%]">Corter Digital</span>
        </a>
        <p class="mt-5 max-w-[30ch] text-[0.9375rem] leading-relaxed text-ink/65">Websites and social media, done for you. Courses and products, if you'd rather do it yourself.</p>
        <p class="label mt-6 flex items-center gap-2"><span class="h-1.5 w-1.5 bg-brand-blue"></span> Online growth, built right</p>
      </div>

      {cols.map((c) => (
        <div>
          <h2 class="label mb-5">{c.title}</h2>
          <ul class="grid gap-3">
            {c.links.map((l) => (
              <li><a href={l.href} class="text-[0.9375rem] text-ink/80 transition-colors hover:text-brand-blue">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h2 class="label mb-5">Get in touch</h2>
        <ul class="grid gap-3">
          <li><a href="tel:+15705024036" class="text-[0.9375rem] text-ink/80 transition-colors hover:text-brand-blue">(570) 502-4036</a></li>
          <li><a href="mailto:andrewcsmma@gmail.com" class="break-all text-[0.9375rem] text-ink/80 transition-colors hover:text-brand-blue">andrewcsmma@gmail.com</a></li>
        </ul>
        <div class="mt-6 flex gap-2">
          <a href="https://www.instagram.com/corterdigital" target="_blank" rel="noopener" class="grid h-10 w-10 place-items-center border border-ink/20 text-ink/80 transition-colors hover:border-brand-blue hover:text-ink" aria-label="Corter Digital on Instagram (opens in a new tab)"><Icon name="instagram" /></a>
          <a href="https://www.facebook.com/profile.php?id=61583891445369" target="_blank" rel="noopener" class="grid h-10 w-10 place-items-center border border-ink/20 text-ink/80 transition-colors hover:border-brand-blue hover:text-ink" aria-label="Corter Digital on Facebook (opens in a new tab)"><Icon name="facebook" /></a>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-ink/10 py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="label">© <span data-year>2026</span> Corter Digital</p>
      <p class="label">Est. 2025</p>
    </div>
  </div>

  <p
    class="pointer-events-none select-none whitespace-nowrap text-center font-display font-bold uppercase leading-[0.78] tracking-[-0.04em] text-transparent [font-stretch:75%]"
    style="font-size: clamp(3.5rem, 15.5vw, 16rem); background: linear-gradient(180deg, rgb(243 239 232 / .12), rgb(243 239 232 / 0) 85%); -webkit-background-clip: text; background-clip: text;"
    aria-hidden="true"
  >Corter Digital</p>
</footer>
