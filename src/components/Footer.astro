---
const cols = [
  { title: 'Done for you', links: [ { href: '/websites', label: 'Websites' }, { href: '/social-media', label: 'Social Media' }, { href: '/portfolio', label: 'Work' } ] },
  { title: 'Do it yourself', links: [ { href: '/courses', label: 'Courses' }, { href: '/learn', label: 'Learn' } ] },
  { title: 'Company', links: [ { href: '/about', label: 'About' }, { href: '/contact', label: 'Contact' } ] },
];
const now = new Date();
const rev = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}`;
---
<footer class="band relative z-[1] marks">
  <div class="frame grid-12 gap-y-12 py-16 lg:py-24">
    <div class="cell col-span-4">
      <p class="label !text-ink">Corter Digital</p>
      <p class="muted mt-4 max-w-[32ch] text-small">Websites and social media, done for you. The playbook behind 10M+ views, if you'd rather do it yourself.</p>
    </div>

    {cols.map((c) => (
      <div class="cell col-span-2">
        <h2 class="label mb-5">{c.title}</h2>
        <ul class="grid gap-2.5 text-small">
          {c.links.map((l) => <li><a href={l.href} class="u-link">{l.label}</a></li>)}
        </ul>
      </div>
    ))}

    <div class="cell col-span-4 lg:col-span-2">
      <h2 class="label mb-5">Contact</h2>
      <ul class="grid gap-2.5 text-small">
        <li><a href="tel:+15705024036" class="u-link num">(570) 502-4036</a></li>
        <li><a href="mailto:andrewcsmma@gmail.com" class="u-link break-all">andrewcsmma@gmail.com</a></li>
        <li><a href="https://www.instagram.com/corterdigital" target="_blank" rel="noopener" class="u-link">Instagram<span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61583891445369" target="_blank" rel="noopener" class="u-link">Facebook<span class="sr-only"> (opens in a new tab)</span></a></li>
      </ul>
    </div>
  </div>

  <div class="band">
    <div class="frame grid-12 py-5">
      <p class="label cell col-span-2 lg:col-span-4">© <span data-year>{now.getFullYear()}</span> Corter Digital</p>
      <p class="label cell col-span-2 text-right lg:col-span-4 lg:text-left">Est. 2025</p>
      <p class="label cell col-span-4 mt-2 lg:mt-0 lg:text-right">Rev. {rev}</p>
    </div>
  </div>
</footer>
