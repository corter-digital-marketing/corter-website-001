---
/**
 * Full-bleed background footage for a hero. Renders nothing until files exist.
 *
 * Drop these into /public/video/ (see README):
 *   hero.mp4          desktop, 1920px wide, ~4–8 MB
 *   hero-mobile.mp4   phones, 720px wide, ~1.5–3 MB
 *   hero-poster.jpg   first frame, shown while the video loads
 * Pass `name` to use other files (name="websites" -> websites.mp4 ...).
 *
 * The video loads after the page is interactive and is skipped for visitors
 * with Data Saver or reduced motion (they see the poster).
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props { name?: string }
const { name = 'hero' } = Astro.props;

const has = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', 'video', f));
const desktop = has(`${name}.mp4`) ? `/video/${name}.mp4` : null;
const mobile = has(`${name}-mobile.mp4`) ? `/video/${name}-mobile.mp4` : desktop;
const poster = has(`${name}-poster.jpg`) ? `/video/${name}-poster.jpg` : null;
const any = desktop || poster;
---
{any && (
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    {poster && <img src={poster} alt="" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" decoding="async" />}
    {desktop && (
      <video
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000"
        muted loop playsinline preload="none"
        poster={poster ?? undefined}
        data-hero-video
        data-src-desktop={desktop}
        data-src-mobile={mobile}
      ></video>
    )}
    <div class="absolute inset-0 bg-black/55"></div>
  </div>
)}
