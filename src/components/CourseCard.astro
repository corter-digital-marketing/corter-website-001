---
/**
 * Course / digital product (courses collection), laid out as a spec sheet.
 * status "live" + checkoutUrl -> Buy button. status "waitlist" -> email signup.
 * CHECKOUT: paste your Stripe / Gumroad / Lemon Squeezy link into the course
 * file's `checkoutUrl` and set `status: "live"`.
 */
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import MediaSlot from './MediaSlot.astro';
import WaitlistForm from './WaitlistForm.astro';

interface Props {
  course: CollectionEntry<'courses'>;
  /** compact: teaser version with a link instead of the signup form */
  compact?: boolean;
}
const { course, compact = false } = Astro.props;
const d = course.data;
const isLive = d.status === 'live' && d.checkoutUrl;
const specs: [string, string][] = [
  ['Format', d.format],
  ['For', d.audience],
  ['Outcome', d.outcome],
  ['Status', isLive ? 'Available now' : 'Waitlist open'],
];
---
<article class="grid-12 border-b border-line">
  <div class="col-span-4 lg:col-span-6 lg:border-r lg:border-line">
    <MediaSlot image={d.image} alt="" need="Course cover or trailer still, 4:3" id={d.kicker} aspect="aspect-[4/3]" sizes="(min-width: 1024px) 50vw, 100vw" />
  </div>

  <div class="col-span-4 flex flex-col lg:col-span-6">
    <div class="cell pb-8 pt-6">
      <p class="label">{d.kicker}</p>
      <h3 class="mt-5 text-heading">{d.title}</h3>
    </div>

    <dl class="border-t border-line">
      {specs.map(([k, v]) => (
        <div class="grid grid-cols-[7rem_1fr] border-b border-line py-3.5 text-small lg:grid-cols-[9rem_1fr]">
          <dt class="label cell">{k}</dt>
          <dd class="cell">{v}</dd>
        </div>
      ))}
    </dl>

    {!compact && d.highlights.length > 0 && (
      <ul class="cell border-b border-line py-5 text-small">
        {d.highlights.map((h, i) => (
          <li class="grid grid-cols-[3rem_1fr] py-1"><span class="label num">{String(i + 1).padStart(2, '0')}</span>{h}</li>
        ))}
      </ul>
    )}

    <div class="cell mt-auto py-8">
      {compact ? (
        <Button href="/courses" variant="secondary" block>View the course</Button>
      ) : isLive ? (
        <Button href={d.checkoutUrl} external block>Buy now</Button>
      ) : (
        <WaitlistForm product={d.title} id={`wl-${course.id}`} />
      )}
    </div>
  </div>
</article>
