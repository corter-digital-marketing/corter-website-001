---
/** One accordion row, aligned to the 12-column grid. Use inside <Accordion>. */
interface Props {
  title: string;
  n?: string;
  meta?: string;
  open?: boolean;
}
const { title, n, meta, open = false } = Astro.props;
---
<details open={open}>
  <summary class="grid-12 items-baseline py-6">
    <span class="label num cell col-span-1">{n}</span>
    <span class="cell col-span-2 lg:col-span-7">{title}</span>
    <span class="label num cell hidden lg:col-span-3 lg:block">{meta}</span>
    <span class="acc-sign cell col-span-1 text-right" aria-hidden="true">+</span>
  </summary>
  <div class="grid-12 pb-8">
    <div class="muted cell col-span-4 lg:col-span-6 lg:col-start-2"><slot /></div>
  </div>
</details>
