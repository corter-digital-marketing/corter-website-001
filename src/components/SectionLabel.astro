---
/** Technical mono label, e.g. "01 / SERVICES" */
interface Props {
  index?: string;
  class?: string;
  as?: 'p' | 'span' | 'div';
  [key: string]: unknown;
}
const { index, class: cls = '', as: Tag = 'p', ...rest } = Astro.props;
---
<Tag class:list={['label flex items-center gap-3', cls]} {...rest}>
  {index && <span class="label-accent">{index}</span>}
  {index && <span aria-hidden="true" class="text-ink/30">/</span>}
  <span><slot /></span>
</Tag>
