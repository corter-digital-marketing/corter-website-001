---
/**
 * Waitlist signup. Posts to the same Formspree form as the contact form,
 * with a subject line so you can tell them apart in your inbox.
 */
import Button from './Button.astro';

interface Props { product: string; id: string }
const { product, id } = Astro.props;
---
<form class="grid gap-4" action="https://formspree.io/f/mwvzvkaw" method="POST" novalidate data-ajax>
  <input type="hidden" name="_subject" value={`Waitlist: ${product}`} />
  <input type="hidden" name="form_type" value="waitlist" />
  <input type="hidden" name="product" value={product} />

  <p class="form-status form-status--success" role="status" tabindex="-1">You're on the list. We'll email you when enrollment opens.</p>
  <p class="form-status form-status--error" role="alert" tabindex="-1">That didn't go through. Please try again.</p>

  <div class="field">
    <label class="text-small font-medium" for={`${id}-email`}>Email</label>
    <input class="input" id={`${id}-email`} type="email" name="email" autocomplete="email" placeholder="you@business.com" required aria-describedby={`${id}-email-err`} />
    <p class="field-error" id={`${id}-email-err`}></p>
  </div>
  <Button type="submit" block>Join the waitlist</Button>
</form>
