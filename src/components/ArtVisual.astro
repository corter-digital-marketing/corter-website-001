---
/**
 * Schematic line-art used in media cards until real photography/footage exists.
 * Purely decorative. Swap for an <Image> by passing `image` to MediaCard.
 */
interface Props {
  variant: 'web' | 'social' | 'course' | 'product' | 'hero' | 'chart';
  fig?: string;
  class?: string;
}
const { variant, fig, class: cls = '' } = Astro.props;

const glow: Record<Props['variant'], string> = {
  web: '70% 35%',
  social: '30% 70%',
  course: '55% 45%',
  product: '50% 55%',
  hero: '65% 40%',
  chart: '20% 80%',
};
---
<div
  class:list={['absolute inset-0 overflow-hidden bg-base', cls]}
  style={`background: radial-gradient(60% 55% at ${glow[variant]}, rgb(47 125 246 / .28), transparent 70%), linear-gradient(160deg, #2E2925 0%, #121009 70%);`}
  aria-hidden="true"
>
  <!-- fine grid -->
  <div
    class="absolute inset-0 opacity-60"
    style="background-image: linear-gradient(rgb(243 239 232 / .05) 1px, transparent 1px), linear-gradient(90deg, rgb(243 239 232 / .05) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 30%, transparent 80%);"
  ></div>

  <svg class="media-zoom absolute inset-0 h-full w-full" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" fill="none">
    <g stroke="#F3EFE8" stroke-opacity=".28" stroke-width="1" vector-effect="non-scaling-stroke">
      {variant === 'web' && (
        <>
          <line x1="0" y1="130" x2="400" y2="130" stroke-dasharray="2 6" />
          <line x1="70" y1="0" x2="70" y2="500" stroke-dasharray="2 6" />
          <rect x="70" y="130" width="300" height="230" />
          <line x1="70" y1="156" x2="370" y2="156" />
          <circle cx="84" cy="143" r="3" /><circle cx="96" cy="143" r="3" /><circle cx="108" cy="143" r="3" />
          <rect x="94" y="184" width="170" height="16" fill="#F3EFE8" fill-opacity=".22" stroke="none" />
          <rect x="94" y="208" width="120" height="16" fill="#F3EFE8" fill-opacity=".22" stroke="none" />
          <line x1="94" y1="244" x2="300" y2="244" /><line x1="94" y1="256" x2="260" y2="256" />
          <rect x="94" y="282" width="84" height="26" fill="#1E5FD1" stroke="#2F7DF6" stroke-opacity="1" />
          <rect x="186" y="282" width="70" height="26" />
          <rect x="300" y="380" width="70" height="120" />
          <line x1="300" y1="400" x2="370" y2="400" />
        </>
      )}
      {variant === 'social' && (
        <>
          <rect x="40" y="150" width="96" height="190" rx="10" />
          <rect x="152" y="110" width="96" height="190" rx="10" />
          <rect x="264" y="170" width="96" height="190" rx="10" />
          <rect x="50" y="166" width="76" height="120" fill="#F3EFE8" fill-opacity=".06" />
          <rect x="162" y="126" width="76" height="120" fill="#2F7DF6" fill-opacity=".18" stroke="#2F7DF6" stroke-opacity=".8" />
          <rect x="274" y="186" width="76" height="120" fill="#F3EFE8" fill-opacity=".06" />
          <path d="M194 176 v20 l17 -10 z" fill="#F3EFE8" fill-opacity=".8" stroke="none" />
          <line x1="0" y1="420" x2="400" y2="420" stroke-dasharray="2 6" />
        </>
      )}
      {variant === 'course' && (
        <>
          <rect x="40" y="110" width="320" height="190" />
          <circle cx="200" cy="205" r="30" />
          <path d="M191 190 v30 l25 -15 z" fill="#F3EFE8" fill-opacity=".85" stroke="none" />
          <line x1="40" y1="320" x2="360" y2="320" />
          <line x1="40" y1="320" x2="210" y2="320" stroke="#2F7DF6" stroke-opacity="1" stroke-width="2" />
          <rect x="40" y="350" width="10" height="10" fill="#2F7DF6" stroke="none" /><line x1="62" y1="355" x2="230" y2="355" />
          <rect x="40" y="376" width="10" height="10" /><line x1="62" y1="381" x2="260" y2="381" />
          <rect x="40" y="402" width="10" height="10" /><line x1="62" y1="407" x2="200" y2="407" />
          <line x1="0" y1="110" x2="400" y2="110" stroke-dasharray="2 6" />
        </>
      )}
      {variant === 'product' && (
        <>
          <path d="M200 140 L320 200 L200 260 L80 200 Z" fill="#2F7DF6" fill-opacity=".2" stroke="#2F7DF6" stroke-opacity=".9" />
          <path d="M80 240 L200 300 L320 240" />
          <path d="M80 280 L200 340 L320 280" />
          <path d="M80 200 V280 M320 200 V280 M200 260 V340" stroke-dasharray="2 5" />
          <line x1="0" y1="420" x2="400" y2="420" stroke-dasharray="2 6" />
        </>
      )}
      {(variant === 'hero' || variant === 'chart') && (
        <>
          <line x1="0" y1="400" x2="400" y2="400" />
          <line x1="0" y1="300" x2="400" y2="300" stroke-dasharray="2 6" />
          <line x1="0" y1="200" x2="400" y2="200" stroke-dasharray="2 6" />
          <path d="M0 395 C60 390 100 380 140 360 S210 330 250 280 S330 180 400 110" stroke="#2F7DF6" stroke-opacity="1" stroke-width="2" />
          <circle cx="250" cy="280" r="4" fill="#2F7DF6" stroke="none" />
          <circle cx="400" cy="110" r="4" fill="#2F7DF6" stroke="none" />
        </>
      )}
    </g>
  </svg>

  {fig && <span class="label absolute left-5 top-5 !text-ink/60">{fig}</span>}
</div>
