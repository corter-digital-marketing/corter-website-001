---
/**
 * A client quote set as a large statement. Without `quote`, renders a marked
 * placeholder. To publish: <Testimonial quote="..." name="..." role="Owner, Business" />
 */
interface Props {
  quote?: string;
  name?: string;
  role?: string;
}
const { quote, name, role } = Astro.props;
const placeholder = !quote;
---
<figure class:list={['grid-12 gap-y-8', placeholder && 'slot py-8']}>
  <blockquote class:list={['cell col-span-4 text-heading lg:col-span-8 lg:col-start-3', placeholder && 'text-ink/45']}>
    {placeholder ? '“[Client quote: one or two sentences about the result. More calls, more customers, less time on marketing.]”' : `“${quote}”`}
  </blockquote>
  <figcaption class="label cell col-span-4 lg:col-span-6 lg:col-start-3">
    {placeholder ? '[Client name] — [Business] · Placeholder' : `${name} — ${role}`}
  </figcaption>
</figure>
