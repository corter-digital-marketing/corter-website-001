---
/**
 * Project card (case-studies collection), laid out like the live site:
 * logo/media, industry tag, client name, one-line description, visit link.
 * Cells share hairlines with their neighbours; place in a .grid-12.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  study: CollectionEntry<'case-studies'>;
  class?: string;
}
const { study, class: cls = '' } = Astro.props;
const d = study.data;
const Tag = d.link ? 'a' : 'article';
const linkProps = d.link ? { href: d.link, target: '_blank', rel: 'noopener' } : {};
---
<Tag {...linkProps} class:list={['group flex flex-col border-b border-line', cls]} data-category={d.service}>
  <div class="relative aspect-[3/2] overflow-hidden" data-reveal-img>
    {d.stat ? (
      <div class="flex h-full flex-col justify-end bg-surface p-[var(--pad)]">
        <p class="num text-display font-medium text-brand-blue">{d.stat}</p>
        <p class="muted mt-3 text-small">{d.statLabel}</p>
      </div>
    ) : d.image && d.imageStyle === 'logo' ? (
      <div class="media absolute inset-0 bg-ink px-[14%] py-[8%]">
        <Image src={d.image} alt={`${d.client} logo`} class="h-full w-full object-contain mix-blend-multiply" widths={[400, 700]} sizes="(min-width: 1024px) 40vw, 90vw" />
      </div>
    ) : d.image ? (
      <Image src={d.image} alt={`${d.client} website`} class="media h-full w-full object-cover" widths={[640, 1024, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" />
    ) : (
      <div class="flex h-full items-center justify-center bg-surface">
        <span class="text-small font-medium">{d.status === 'in-progress' ? 'Coming soon' : d.client}</span>
      </div>
    )}
  </div>

  <div class="cell flex flex-1 flex-col pb-8 pt-6">
    <p class="muted text-small">{d.industry}</p>
    <h3 class="mt-2 text-heading"><span class:list={[d.link && 'u-link']}>{d.client}</span></h3>
    <p class="muted mt-3 max-w-[48ch]">{d.summary}</p>
    {d.result && <p class="mt-4 text-small font-medium">{d.result}</p>}
    {d.link && (
      <p class="mt-auto pt-6"><span class="btn btn-secondary">{d.linkLabel} <span class="arrow" aria-hidden="true">↗</span></span><span class="sr-only"> (opens in a new tab)</span></p>
    )}
  </div>
</Tag>
