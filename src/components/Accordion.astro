---
/** Wrapper for AccordionItems. `single` closes the others when one opens. */
interface Props {
  single?: boolean;
  class?: string;
}
const { single = true, class: cls = '' } = Astro.props;
---
<div class:list={['accordion border-t border-line', cls]} data-accordion={single ? 'single' : 'multi'}>
  <slot />
</div>
