---
/**
 * Homepage. Same layout and information as the live corterdigital.com homepage
 * (brand mark, intro + stats, services, custom work, contact), in the new style.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/HeroMedia.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';
import logo from '../assets/logo-mark.png';

const services = [
  { title: 'Websites', text: 'We build, deploy, and maintain your website.', href: '/websites' },
  { title: 'Social Media', text: 'Handle your social media, and reach the right audience.', href: '/social-media' },
  { title: 'SEO', text: 'Get found on Google and Bing, and in AI answers from ChatGPT, Claude and Gemini.', href: '/seo' },
];
---
<BaseLayout
  title="Corter Digital | Websites, Social Media & Content Creation"
  description="Corter Digital builds professional websites and runs social media marketing and content creation for businesses that want real customers. 10M+ views, 60K+ followers gained."
>
  <!-- ═══ HERO: brand mark + intro + stats ═══ -->
  <section class="relative pt-[72px]" aria-labelledby="hero-title">
    <HeroMedia name="hero" />

    <!-- Brand mark, centered -->
    <div class="frame grid-12 relative pt-14 lg:pt-20">
      <div class="cell col-span-4 flex justify-center lg:col-span-12">
        <Image src={logo} alt="Corter Digital" width={176} densities={[1, 2]} class="h-auto w-28 lg:w-44" loading="eager" />
      </div>
    </div>

    <!-- Headline across the full width -->
    <div class="frame grid-12 relative pt-10 lg:pt-14">
      <h1 id="hero-title" class="cell col-span-4 text-center text-display font-medium lg:col-span-12" data-split>
        Proven solutions to help grow your business.
      </h1>
    </div>

    <!-- Views and followers, below the headline -->
    <div class="frame grid-12 relative pb-16 pt-12 lg:pb-24 lg:pt-16">
      <div class="col-span-4 border border-line text-center lg:col-span-6 lg:col-start-4">
        <div class="grid grid-cols-2">
          <div class="cell border-r border-line py-7">
            <p class="num text-heading font-medium" data-count="10" data-suffix="M+">10M+</p>
            <p class="mt-2 text-small font-medium">Views achieved</p>
          </div>
          <div class="cell py-7">
            <p class="num text-heading font-medium" data-count="60" data-suffix="K+">60K+</p>
            <p class="mt-2 text-small font-medium">Followers gained</p>
          </div>
        </div>
        <p class="muted cell border-t border-line py-3 text-small">*Across all social medias combined</p>
        <div class="cell border-t border-line py-5">
          <Button href="/contact" block>Speak to a professional</Button>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══ SERVICES ═══ -->
  <section class="band marks" id="services" aria-labelledby="services-title">
    <div class="frame grid-12 pb-10 pt-14 lg:pb-14 lg:pt-20">
      <h2 id="services-title" class="cell col-span-4 text-display font-medium lg:col-span-12">Services</h2>
    </div>

    <ul class="frame grid-12 border-t border-line">
      {services.map((s, i) => (
        <li class:list={['col-span-4 border-b border-line', i < services.length - 1 && 'lg:border-r']}>
          <a href={s.href} class="group cell flex h-full min-h-[300px] flex-col py-10 lg:min-h-[380px] lg:py-12">
            <h3 class="text-heading"><span class="u-link">{s.title}</span></h3>
            <p class="muted mt-4 max-w-[34ch]">{s.text}</p>
            <p class="mt-auto pt-10"><span class="btn btn-primary">View more <span class="arrow" aria-hidden="true">→</span></span></p>
          </a>
        </li>
      ))}
    </ul>

    <!-- Custom work -->
    <div class="frame grid-12 border-b border-line py-8 lg:py-10">
      <p class="cell col-span-4 text-body font-medium lg:col-span-8">Looking for something that's not listed here? We take on custom work too.</p>
      <div class="cell col-span-4 mt-6 lg:col-span-4 lg:mt-0 lg:text-right">
        <Button href="/contact" variant="secondary">Fill out the form</Button>
      </div>
    </div>
  </section>


  <!-- ═══ CONTACT ═══ -->
  <section class="band" id="contact" aria-labelledby="contact-title">
    <div class="frame grid-12 py-section">
      <div class="cell col-span-4 lg:col-span-5">
        <p class="muted text-small font-medium">Get started</p>
        <h2 id="contact-title" class="mt-6 text-display font-medium">Let's talk about <span class="text-brand-blue">your business.</span></h2>
        <p class="muted mt-8 max-w-[40ch] text-body">No pitch. Just a straight conversation about where you are and where you want to be.</p>

        <dl class="mt-12 border-t border-line">
          <div class="grid grid-cols-[6rem_1fr] items-baseline border-b border-line py-5">
            <dt class="muted text-small">Phone</dt>
            <dd><a href="tel:+15705024036" class="num u-link text-heading">(570) 502-4036</a></dd>
          </div>
          <div class="grid grid-cols-[6rem_1fr] items-baseline border-b border-line py-5">
            <dt class="muted text-small">Email</dt>
            <dd><a href="mailto:andrewcsmma@gmail.com" class="u-link break-all text-body">andrewcsmma@gmail.com</a></dd>
          </div>
        </dl>
      </div>

      <div class="cell col-span-4 mt-16 lg:col-span-5 lg:col-start-8 lg:mt-0">
        <ContactForm id="home" />
      </div>
    </div>
  </section>
</BaseLayout>
