---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/HeroMedia.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import StatCounter from '../components/StatCounter.astro';
import MediaCard from '../components/MediaCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Testimonial from '../components/Testimonial.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';

const studies = (await getCollection('case-studies', (s) => s.data.featured)).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = studies;
const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Corter Digital | Websites, Social Media & Courses That Bring in Customers"
  description="We've driven 10M+ views. Corter Digital builds websites and runs social media that bring in real customers, or teaches you our exact playbook."
>
  <!-- ═══════════ HERO ═══════════ -->
  <section class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden" data-hero aria-labelledby="hero-title">
    <HeroMedia name="hero" art="hero" />

    <div class="container-x relative pb-10 pt-40 md:pb-14">
      <p class="label mb-8 flex items-center gap-3" data-reveal>
        <span class="h-1.5 w-1.5 bg-brand-blue"></span> Corter Digital · Est. 2025
      </p>
      <h1 id="hero-title" class="display-xl max-w-[13ch]" data-split="load">
        We've driven 10M+ views. <span class="dim">Now we'll do it for your business.</span>
      </h1>

      <div class="mt-10 grid gap-8 md:mt-14 lg:grid-cols-[1fr_auto] lg:items-end">
        <p class="lead max-w-[46ch]" data-reveal>Websites, social media, and content that bring in real customers. Or learn our exact playbook yourself.</p>
        <div class="flex flex-col gap-3 sm:flex-row" data-reveal>
          <Button href="/contact">Book a free call</Button>
          <Button href="/courses" variant="secondary">Explore courses</Button>
        </div>
      </div>

      <!-- hero index bar -->
      <div class="mt-14 hidden grid-cols-4 border-t border-ink/15 pt-5 md:grid" data-reveal>
        <a href="/websites" class="label hover:!text-ink"><span class="label-accent">01</span>&nbsp;&nbsp;Websites</a>
        <a href="/social-media" class="label hover:!text-ink"><span class="label-accent">02</span>&nbsp;&nbsp;Social Media</a>
        <a href="/courses" class="label hover:!text-ink"><span class="label-accent">03</span>&nbsp;&nbsp;Courses</a>
        <span class="label flex items-center justify-end gap-2">Scroll <Icon name="arrow-down" class="h-3.5 w-3.5 animate-bounce" /></span>
      </div>
    </div>
  </section>


  <!-- ═══════════ PROOF ═══════════ -->
  <section class="border-t border-ink/10 bg-base" aria-labelledby="proof-title">
    <div class="container-x">
      <div class="grid border-ink/10 sm:grid-cols-2 lg:grid-cols-4 lg:border-l">
        <div class="flex flex-col justify-between gap-8 border-b border-ink/10 py-10 sm:border-r lg:border-b-0 lg:p-10">
          <SectionLabel index="01">Proof</SectionLabel>
          <h2 id="proof-title" class="display-sm max-w-[12ch]">Numbers, not promises.</h2>
        </div>
        <StatCounter value={10} suffix="M+" label="Views generated" class="border-b border-ink/10 !px-0 sm:!px-10 lg:border-b-0 lg:border-r" />
        <StatCounter value={60} suffix="K+" label="Followers gained" class="border-b border-ink/10 !px-0 sm:border-r sm:!px-10 lg:border-b-0" />
        <StatCounter value={250} suffix="K+" label="Views in 30 days, one client" class="!px-0 sm:!px-10 lg:border-l lg:border-r lg:border-ink/10" />
      </div>
      <p class="label border-t border-ink/10 py-4 !text-[0.625rem]">Views and followers are totals across all platforms.</p>
    </div>
  </section>


  <!-- ═══════════ SERVICES ═══════════ -->
  <section class="section border-t border-ink/10" aria-labelledby="services-title">
    <div class="container-x">
      <div class="mb-14 grid gap-8 lg:mb-20 lg:grid-cols-2 lg:items-end">
        <div>
          <SectionLabel index="02" class="mb-8">Services</SectionLabel>
          <h2 id="services-title" class="display-lg" data-split>Done for you.<br /><span class="dim">Or learn it yourself.</span></h2>
        </div>
        <p class="lead max-w-[40ch] lg:justify-self-end">Two ways to grow. Hand it to us, or take our playbook and run it yourself.</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-stagger>
        <MediaCard
          href="/websites"
          kicker="01 — Done for you"
          title="A website that turns visitors into calls."
          text="Fast on every phone. Built to be found. Maintained for you."
          cta="Websites"
          art="web"
          fig="Fig. 01 · Website"
        />
        <MediaCard
          href="/social-media"
          kicker="02 — Done for you"
          title="Content that gets you seen."
          text="We plan, create and post. Your audience grows. You get the calls."
          cta="Social Media"
          art="social"
          fig="Fig. 02 · Social"
        />
        <MediaCard
          href="/courses"
          kicker="03 — Learn it yourself"
          title="Our playbook, in your hands."
          text="The exact system behind 10M+ views, as a course you run yourself."
          cta="Courses"
          art="course"
          fig="Fig. 03 · Course"
          class="md:col-span-2 lg:col-span-1"
          aspect="aspect-[4/5] md:aspect-[16/9] lg:aspect-[4/5]"
        />
      </div>
    </div>
  </section>


  <!-- ═══════════ PROCESS (pinned on desktop) ═══════════ -->
  <ProcessSteps
    index="03"
    line1="Talk. Build."
    line2="Grow."
    steps={[
      { title: 'Talk', text: 'A straight conversation about your business, your customers, and what isn’t working. No pitch.' },
      { title: 'Build', text: 'We design your site or plan your content around real goals. You review. We refine. It goes live.' },
      { title: 'Grow', text: 'We keep posting, updating and improving, month after month, so the calls keep coming.' },
    ]}
  />


  <!-- ═══════════ WORK ═══════════ -->
  <section class="section border-t border-ink/10" aria-labelledby="work-title">
    <div class="container-x">
      <div class="mb-14 flex flex-col gap-8 lg:mb-20 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <SectionLabel index="04" class="mb-8">Case studies</SectionLabel>
          <h2 id="work-title" class="display-lg" data-split>Outcomes.<br /><span class="dim">Not deliverables.</span></h2>
        </div>
        <Button href="/portfolio" variant="secondary">View all work</Button>
      </div>

      {featured && <CaseStudyCard study={featured} size="feature" class="mb-4" />}
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-stagger>
        {rest.map((s) => <CaseStudyCard study={s} />)}
      </div>
    </div>
  </section>


  <!-- ═══════════ COURSES TEASER ═══════════ -->
  <section class="section relative overflow-hidden border-t border-ink/10 bg-surface" aria-labelledby="courses-title">
    <div class="absolute inset-0" style="background: radial-gradient(50% 60% at 100% 50%, rgb(47 125 246 / .16), transparent 70%);" aria-hidden="true"></div>
    <div class="container-x relative grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-20">
      <div>
        <SectionLabel index="05" class="mb-8">Courses</SectionLabel>
        <h2 id="courses-title" class="display-lg" data-split>Rather do it yourself?<br /><span class="dim">Learn our playbook.</span></h2>
        <p class="lead mt-8 max-w-[42ch]" data-reveal>The same strategies behind 10M+ views and 60K+ followers, broken down so you can run them at your own pace.</p>
        <div class="mt-10" data-reveal><Button href="/courses">Explore courses</Button></div>
      </div>
      <div data-reveal>
        {courses[0] && <CourseCard course={courses[0]} compact />}
      </div>
    </div>
  </section>


  <!-- ═══════════ TESTIMONIALS ═══════════ -->
  <section class="section border-t border-ink/10" aria-labelledby="clients-title">
    <div class="container-x">
      <SectionLabel index="06" class="mb-8">Clients</SectionLabel>
      <h2 id="clients-title" class="display-lg mb-14 lg:mb-20" data-split>In their words.</h2>
      <!-- Replace placeholders with: <Testimonial quote="..." name="..." role="Owner, Business" /> -->
      <div class="grid gap-4 md:grid-cols-2" data-stagger>
        <Testimonial placeholder />
        <Testimonial placeholder />
      </div>
    </div>
  </section>


  <!-- ═══════════ CONTACT ═══════════ -->
  <section class="section relative overflow-hidden border-t border-ink/10" id="contact" aria-labelledby="contact-title">
    <div class="absolute inset-0" style="background: radial-gradient(60% 70% at 0% 100%, rgb(47 125 246 / .2), transparent 65%);" aria-hidden="true"></div>
    <div class="grid-guides" aria-hidden="true"></div>
    <div class="container-x relative grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionLabel index="07" class="mb-8">Contact</SectionLabel>
        <h2 id="contact-title" class="display-lg" data-split>No pitch.<br /><span class="dim">Just a straight conversation.</span></h2>
        <p class="lead mt-8 max-w-[40ch]" data-reveal>Tell us where you are and where you want to be. We'll tell you exactly how we'd get you there.</p>

        <dl class="mt-12 grid border-t border-ink/10" data-reveal>
          <div class="flex items-center justify-between gap-4 border-b border-ink/10 py-5">
            <dt class="label">Phone</dt>
            <dd><a href="tel:+15705024036" class="font-display text-xl font-semibold [font-stretch:82%] hover:text-brand-blue">(570) 502-4036</a></dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-ink/10 py-5">
            <dt class="label">Email</dt>
            <dd><a href="mailto:andrewcsmma@gmail.com" class="break-all text-right font-display text-xl font-semibold [font-stretch:82%] hover:text-brand-blue">andrewcsmma@gmail.com</a></dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-ink/10 py-5">
            <dt class="label">Response</dt>
            <dd class="text-right text-ink/80">Usually the same day</dd>
          </div>
        </dl>
      </div>

      <div class="ticks border border-ink/12 bg-base/60 p-6 backdrop-blur md:p-10" data-reveal>
        <p class="label mb-2">Send a message</p>
        <p class="mb-8 text-ink/70">Takes a minute. We'll take it from there.</p>
        <ContactForm id="home" />
      </div>
    </div>
  </section>
</BaseLayout>
