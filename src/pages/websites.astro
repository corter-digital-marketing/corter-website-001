---
/** Websites. Same information as the live websites page, laid out simply, without prices. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import OptionList from '../components/OptionList.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Closing from '../components/Closing.astro';

const work = (await getCollection('case-studies', (s) => s.data.service === 'websites')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Websites | Corter Digital"
  description="Custom tailored websites built to serve your business. Template or fully custom builds, plus hosting and ongoing care. Get a free quote."
>
  <PageHero
    meta={['Websites']}
    title="Built. Hosted. Cared for."
    lead="Custom tailored websites built to serve your business. We build, deploy and maintain your site to ensure quality and consistency throughout the entire process."
  />

  <Section name="Website build" id="options" meta="Get your business online, from a fast template launch to a fully custom site.">
    <div class="frame">
      <OptionList
        options={[
          { name: 'Template Build', text: 'The fastest way to get online.', features: ['Professionally designed template, customized to your brand', 'Mobile-first, fast-loading build', 'Direct-to-email contact forms'] },
          { name: 'Custom Build', text: 'Built around your business.', features: ['Fully custom design, no template', 'SEO and Google Business integration', 'Booking, e-commerce, databases, and more'] },
        ]}
      />
    </div>
  </Section>

  <Section name="Website maintenance" meta="Ongoing hosting and upkeep so your site stays fast, secure, and up to date long after launch.">
    <div class="frame">
      <OptionList
        options={[
          { name: 'Care', text: 'We look after your site so you don’t have to.', features: ['Hosting and backups', 'Security and uptime monitoring', 'Content edits and speed optimization', 'Performance reporting'] },
        ]}
      />
    </div>
  </Section>

  <Section name="Websites we've built">
    <div class="frame grid-12 border-t border-line">
      {work.map((s, i) => (
        <CaseStudyCard study={s} class:list={['col-span-4 lg:col-span-6', i % 2 === 0 && 'lg:border-r lg:border-line']} />
      ))}
    </div>
  </Section>

  <Closing n="04" title="Ready to get your site online?" cta="Start the conversation" />
</BaseLayout>
