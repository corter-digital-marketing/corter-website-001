---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Accordion from '../components/Accordion.astro';
import AccordionItem from '../components/AccordionItem.astro';
import PricingTable from '../components/PricingTable.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Closing from '../components/Closing.astro';

const work = (await getCollection('case-studies', (s) => s.data.service === 'websites' && s.data.status === 'live'))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Websites | Corter Digital"
  description="Websites that turn visitors into calls. Template builds from $200, custom builds quoted, hosting and care plans from $99 a month."
>
  <PageHero
    meta={['01 — Websites', 'Done for you', 'Builds from $200', 'Care from $99/mo']}
    title="A website that turns visitors into calls."
    lead="Template builds from $200. Custom builds for stores, bookings and databases. We host it and keep it running after launch."
  >
    <Button href="/contact">Get a quote</Button>
    <Button href="#pricing" variant="secondary">See pricing</Button>
  </PageHero>

  <!-- 01 Included: split, accordion -->
  <Section n="01" name="What's included" meta="6 parts">
    <div class="frame grid-12 py-12 lg:py-20">
      <p class="cell col-span-4 text-heading lg:col-span-4">Every build is set up to be found and to get you contacted.</p>
      <div class="col-span-4 mt-10 lg:col-span-8 lg:mt-0">
        <Accordion>
          <AccordionItem n="01" title="Design" meta="Template or custom">A professional template customized to your brand, or a fully custom design with no template underneath.</AccordionItem>
          <AccordionItem n="02" title="Mobile-first build" meta="All builds">Most visitors arrive on a phone. Every site is built for phones first and loads fast.</AccordionItem>
          <AccordionItem n="03" title="Found on Google" meta="Custom builds">SEO architecture and Google Business integration, so people searching for what you do find you.</AccordionItem>
          <AccordionItem n="04" title="Leads to your inbox" meta="All builds">Contact and booking forms that send straight to your email. Nothing to log into.</AccordionItem>
          <AccordionItem n="05" title="Stores, bookings, databases" meta="Custom builds">Checkout, bulk ordering and booking requests are live on sites we've built. A self-managed product catalog is in development now.</AccordionItem>
          <AccordionItem n="06" title="Hosting and care" meta="From $99/mo">Hosting, backups, security and uptime monitoring, with edits and reporting on higher plans.</AccordionItem>
        </Accordion>
      </div>
    </div>
  </Section>

  <!-- 02 Pricing: spec table -->
  <Section n="02" name="Pricing" meta="5 plans" id="pricing" marks>
    <div class="frame py-12 lg:py-20">
      <PricingTable
        title="Build"
        caption="One-time"
        plans={[
          { name: 'Template', note: 'Fastest way online', price: '$200', unit: 'once', features: ['Professional template, customized to your brand', 'Mobile-first, fast-loading build', 'Contact forms sent to your email'], cta: 'Get started' },
          { name: 'Custom', note: 'Built around your business', price: 'Quoted', features: ['Fully custom design, no template', 'SEO architecture and Google Business integration', 'Booking, e-commerce, databases, and more'], cta: 'Request a quote', highlight: false },
        ]}
      />
      <div class="h-16 lg:h-24"></div>
      <PricingTable
        title="Care"
        caption="Monthly"
        plans={[
          { name: 'Essentials', note: 'Keep it running', price: '$99', unit: '/mo', features: ['Hosting', 'Backups', 'Security monitoring', 'Uptime monitoring'] },
          { name: 'Growth', note: 'Keep it improving', price: '$199', unit: '/mo', features: ['Everything in Essentials', 'Monthly content edits', 'Monthly performance reporting', 'Speed optimization'] },
          { name: 'Priority', note: 'Keep it converting', price: '$349', unit: '/mo', features: ['Everything in Growth', 'Same-day changes', 'Conversion tweaks', 'A/B testing'] },
        ]}
      />
    </div>
  </Section>

  <!-- 03 Process: columns -->
  <Section n="03" name="Process" meta="3 steps">
    <ol class="frame grid-12">
      {[
        ['Talk', 'One call about your business, your customers, and what the site has to do. You leave with a price.'],
        ['Build', 'We design and build. You review it, we revise it, and it goes live when you sign off.'],
        ['Run', 'We deploy, host, back up and monitor it. Edits and reporting are included on Growth and Priority.'],
      ].map(([t, d], i) => (
        <li class:list={['cell col-span-4 py-10 lg:py-14', i > 0 && 'border-t border-line lg:border-t-0']}>
          <p class="label num">Step {String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-12 text-heading lg:mt-24">{t}</h3>
          <p class="muted mt-4 max-w-[34ch]">{d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- 04 Results: case cells -->
  <Section n="04" name="Sites we've built" meta={`${work.length} live`}>
    <div class="frame grid-12">
      {work.map((s, i) => (
        <CaseStudyCard study={s} n={String(i + 1).padStart(2, '0')} class="col-span-4 lg:border-r lg:border-line lg:last:border-r-0" />
      ))}
    </div>
  </Section>

  <!-- 05 FAQ: split -->
  <Section n="05" name="Questions" meta="5 answers">
    <div class="frame grid-12 py-12 lg:py-20">
      <p class="cell col-span-4 text-heading lg:col-span-4">Straight answers.</p>
      <div class="col-span-4 mt-10 lg:col-span-8 lg:mt-0">
        <Accordion>
          <AccordionItem n="01" title="Template or custom: which do I need?">If your site mainly explains what you do and gets people to call, start with a template. If customers need to buy, book, or log in, go custom.</AccordionItem>
          <AccordionItem n="02" title="How long does it take?">Templates are the fastest way online. Custom timelines depend on what the site has to do. You get a date on the first call, before any work starts.</AccordionItem>
          <AccordionItem n="03" title="What do care plans cover?">Essentials: hosting, backups, security and uptime monitoring. Growth adds monthly edits, reporting and speed work. Priority adds same-day changes, conversion tweaks and A/B testing.</AccordionItem>
          <AccordionItem n="04" title="Can you add a store or bookings?">Yes. We've shipped checkout with bulk ordering and booking request forms, and we're building a catalog the owner updates themselves.</AccordionItem>
          <AccordionItem n="05" title="Can I change things after launch?">Yes. Growth includes monthly edits and Priority includes same-day changes. We can also build in a way for you to edit it yourself.</AccordionItem>
        </Accordion>
      </div>
    </div>
  </Section>

  <Closing n="06" title="Get your site online." cta="Get a quote" />
</BaseLayout>
