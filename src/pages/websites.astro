---
/** Websites. Same information as the live websites page, laid out simply. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PricingTable from '../components/PricingTable.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Closing from '../components/Closing.astro';

const work = (await getCollection('case-studies', (s) => s.data.service === 'websites')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Websites | Corter Digital"
  description="Custom tailored websites built to serve your business. Template builds from $200, custom builds quoted, and care plans from $99 a month."
>
  <PageHero
    meta={['Websites']}
    title="Built. Hosted. Cared for."
    lead="Custom tailored websites built to serve your business. We build, deploy and maintain your site to ensure quality and consistency throughout the entire process."
  />

  <Section name="Website build" id="pricing" meta="A one-time build to get your business online, from a fast template launch to a fully custom site.">
    <div class="frame">
      <PricingTable
        plans={[
          { name: 'Template Build', note: 'Fastest way to get online', price: '$200', unit: 'one-time', features: ['Professionally designed template, customized to your brand', 'Mobile-first, fast-loading build', 'Direct-to-email contact forms'], cta: 'Get started' },
          { name: 'Custom Build', note: 'Built around your business', price: 'Quoted', features: ['Fully custom design, no template', 'SEO and Google Business integration', 'Booking, e-commerce, databases, and more'], cta: 'Get a quote' },
        ]}
      />
    </div>
  </Section>

  <Section name="Website maintenance" meta="Ongoing hosting and upkeep so your site stays fast, secure, and up to date long after launch.">
    <div class="frame">
      <PricingTable
        plans={[
          { name: 'Essentials', note: 'Keep it running', price: '$99', unit: '/mo', features: ['Hosting', 'Backups', 'Security monitoring', 'Uptime monitoring'] },
          { name: 'Growth', note: 'Everything in Essentials, plus:', price: '$199', unit: '/mo', features: ['Monthly content edits', 'Monthly performance reporting', 'Speed optimization'] },
          { name: 'Priority', note: 'Everything in Growth, plus:', price: '$349', unit: '/mo', features: ['Same-day changes', 'Conversion tweaks', 'A/B testing'] },
        ]}
      />
    </div>
  </Section>

  <Section name="Websites we've built">
    <div class="frame grid-12 border-t border-line">
      {work.map((s, i) => (
        <CaseStudyCard study={s} class:list={['col-span-4 lg:col-span-6', i % 2 === 0 && 'lg:border-r lg:border-line']} />
      ))}
    </div>
  </Section>

  <Closing n="04" title="Ready to get your site online?" cta="Start the conversation" />
</BaseLayout>
