---
/** About. Same layout and information as the live about page, in the new style. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Stat from '../components/Stat.astro';
---
<BaseLayout
  title="About | Corter Digital"
  description="Corter Digital builds websites, social media, and content systems for businesses that want their phone to ring more. We build, deploy, and maintain everything ourselves."
>
  <PageHero
    meta={['About']}
    title="Elevate your business."
    lead="Corter Digital is a studio building websites, social media, and content systems for businesses that want their phone to ring more. We build, deploy, and maintain everything ourselves."
  />

  <!-- Stats -->
  <Section n="01" name="Our results" meta="*Across all social medias combined" marks>
    <div class="frame grid-12">
      <Stat value={10} suffix="M+" label="Views achieved*" class="col-span-2 lg:col-span-6" />
      <Stat value={150} suffix="K+" label="Followers gained*" class="col-span-2 lg:col-span-6" />
    </div>
  </Section>

  <!-- Contact band -->
  <Section n="02" name="Get in touch">
    <ul class="frame grid-12">
      {[
        { label: 'Instagram', value: '@corterdigital', href: 'https://www.instagram.com/corterdigital', ext: true },
        { label: 'Facebook', value: 'Corter Digital', href: 'https://www.facebook.com/profile.php?id=61583891445369', ext: true },
        { label: 'Email', value: 'andrewcsmma@gmail.com', href: 'mailto:andrewcsmma@gmail.com', ext: false },
        { label: 'Phone', value: '(570) 502-4036', href: 'tel:+15705024036', ext: false },
      ].map((c, i) => (
        <li class:list={['col-span-4 border-b border-line lg:col-span-3', i < 3 && 'lg:border-r']}>
          <a href={c.href} class="group cell flex h-full flex-col gap-3 py-10" {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="muted text-small">{c.label}</span>
            <span class="num break-all text-body font-medium"><span class="u-link">{c.value}</span> <span class="arrow" aria-hidden="true">{c.ext ? '↗' : '→'}</span></span>
            {c.ext && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
