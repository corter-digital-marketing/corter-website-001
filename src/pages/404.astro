---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Page not found | Corter Digital" description="This page doesn't exist. Head back to the Corter Digital homepage.">
  <PageHero meta={['Error 404', 'Not found', 'Corter Digital', 'Index —']} title="This page doesn't exist." lead="The link may be old, or the page moved when we rebuilt the site.">
    <Button href="/">Back to home</Button>
    <Button href="/contact" variant="secondary">Contact</Button>
  </PageHero>
</BaseLayout>
