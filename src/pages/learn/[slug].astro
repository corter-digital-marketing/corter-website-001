---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
  return articles.map((article, i) => ({
    params: { slug: article.id },
    props: { article, n: i + 1, next: articles[(i + 1) % articles.length] },
  }));
}

const { article, n, next } = Astro.props;
const { Content } = await render(article);
const d = article.data;
---
<BaseLayout title={`${d.title} | Corter Digital`} description={d.description}>
  <article>
    <header class="pt-[72px]">
      <div class="frame grid-12 border-b border-line">
        <nav class="cell col-span-4 py-4 text-small lg:col-span-8" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="muted u-link">Home</a></li><li class="muted" aria-hidden="true">›</li>
            <li><a href="/learn" class="muted u-link">Free guides</a></li><li class="muted" aria-hidden="true">›</li>
            <li aria-current="page" class="font-medium">Guide {n}</li>
          </ol>
        </nav>
        <p class="muted cell hidden py-4 text-right text-small lg:col-span-4 lg:block">{d.topic} · {d.readingTime} read</p>
      </div>
      <div class="frame grid-12 pb-16 pt-20 lg:pb-24 lg:pt-28">
        <h1 class="cell col-span-4 text-heading lg:col-span-8" data-split>{d.title}</h1>
        <p class="muted cell col-span-4 mt-8 lg:col-span-5 lg:col-start-1">{d.description}</p>
      </div>
    </header>

    <div class="band">
      <div class="frame grid-12 py-14 lg:py-20">
        <aside class="cell col-span-4 mb-10 lg:col-span-3 lg:mb-0" aria-label="Article details">
          <dl class="label grid gap-3 lg:sticky lg:top-24">
            <div class="flex justify-between lg:block"><dt>Topic</dt><dd class="!text-ink lg:mt-1">{d.topic}</dd></div>
            <div class="flex justify-between lg:block lg:pt-3"><dt>Read</dt><dd class="!text-ink lg:mt-1">{d.readingTime}</dd></div>
            <div class="flex justify-between lg:block lg:pt-3"><dt>By</dt><dd class="!text-ink lg:mt-1">Corter Digital</dd></div>
          </dl>
        </aside>
        <div class="prose-doc cell col-span-4 lg:col-span-6 lg:col-start-4">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- Next + CTA -->
  <div class="band">
    <a href={`/learn/${next.id}`} class="row group frame grid-12 items-baseline py-8">
      <span class="label cell col-span-4 lg:col-span-3">Next guide</span>
      <span class="cell col-span-4 mt-3 text-heading lg:col-span-8 lg:mt-0"><span class="u-link">{next.data.title}</span></span>
      <span class="cell hidden text-right lg:col-span-1 lg:block" aria-hidden="true"><span class="arrow">→</span></span>
    </a>
  </div>
  <section class="band marks" aria-label="Get help">
    <div class="frame grid-12 py-section">
      <p class="cell col-span-4 text-heading lg:col-span-6">Rather have us do it? One call, no pitch.</p>
      <div class="cell col-span-4 mt-10 flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:col-start-8 lg:mt-0 lg:justify-end lg:self-end">
        <Button href="/contact">Book a free call</Button>
        <Button href="/courses" variant="secondary">See the course</Button>
      </div>
    </div>
  </section>
</BaseLayout>
