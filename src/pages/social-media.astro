---
/** Social Media. Same information as the live social media page, laid out simply, without prices. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import OptionList from '../components/OptionList.astro';
import Closing from '../components/Closing.astro';
---
<BaseLayout
  title="Social Media Management | Corter Digital"
  description="Engaging content for your business, a growing following, and new clients. Social media management and content creation. Get a free quote."
>
  <PageHero
    meta={['Social Media']}
    title="Grow the right way."
    lead="Create engaging content for your business, grow your following and find new clients. We know what works, and we put your content in front of the right people to make it memorable."
  />

  <Section name="What we offer" id="options" meta="Hand us your pages, or just get the content. Built around your goals.">
    <div class="frame">
      <OptionList
        options={[
          { name: 'Social media management', text: 'Consistent, on-brand posting across your platforms.', features: ['Up to 3 platforms managed', 'Posting from twice a week to every day', 'Video content'] },
          { name: 'Content creation', text: 'Photos and videos made for you. Post them yourself, or add management.', features: ['Custom in-person content shoot', 'Photo and video for web and social', 'Long-form footage clipped into short videos'] },
        ]}
      />
    </div>
  </Section>

  <Closing n="04" title="Ready to grow your following?" cta="Start the conversation" />
</BaseLayout>
