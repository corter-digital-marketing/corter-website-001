---
/** Contact. Same layout and information as the live contact page, in the new style. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout
  title="Contact | Corter Digital"
  description="No pitch. Just a real conversation about your business and where you want to take it. Call (570) 502-4036 or send a message. We typically respond the same day."
>
  <PageHero
    meta={['Contact', 'We typically respond the same day']}
    title="Let's build something great."
    lead="No pitch. Just a real conversation about your business and where you want to take it."
  />

  <section class="band marks" aria-label="Contact details and form">
    <div class="frame grid-12 py-14 lg:py-24">
      <!-- Reach us directly -->
      <div class="cell col-span-4 lg:col-span-5">
        <h2 class="text-heading">Reach us directly</h2>
        <dl class="mt-8 border-t border-line">
          <div class="grid grid-cols-[6rem_1fr] items-baseline border-b border-line py-5">
            <dt class="muted text-small">Phone</dt>
            <dd><a href="tel:+15705024036" class="num u-link text-heading">(570) 502-4036</a></dd>
          </div>
          <div class="grid grid-cols-[6rem_1fr] items-baseline border-b border-line py-5">
            <dt class="muted text-small">Email</dt>
            <dd><a href="mailto:andrewcsmma@gmail.com" class="u-link break-all text-body">andrewcsmma@gmail.com</a></dd>
          </div>
        </dl>
        <p class="muted mt-8 max-w-[40ch]">We typically respond the same day. For fastest results, call us directly.</p>
      </div>

      <!-- Send us a message -->
      <div class="cell col-span-4 mt-16 lg:col-span-5 lg:col-start-8 lg:mt-0">
        <h2 class="mb-8 text-heading">Send us a message</h2>
        <ContactForm id="contact" />
      </div>
    </div>
  </section>
</BaseLayout>
